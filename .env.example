# =============================================================================
# Stage Tracker - Configuration
# =============================================================================
# Copie ce fichier en .env et remplis les valeurs
# cp .env.example .env
# =============================================================================

# -----------------------------------------------------------------------------
# OBLIGATOIRE : Identification
# -----------------------------------------------------------------------------
USER_FULL_NAME=Prénom Nom

# -----------------------------------------------------------------------------
# OPTIONNEL : Gemini (pour la génération des réponses)
# Si tu ne veux pas utiliser Gemini, laisse vide ou commente
# -----------------------------------------------------------------------------
GEMINI_API_KEY=
GEMINI_MODEL=gemini-flash-latest
# Modèles de repli, essayés dans l'ordre si le modèle principal est saturé (503)
# ou indisponible. Séparés par des virgules, sans espaces.
GEMINI_FALLBACK_MODELS=gemini-2.5-flash,gemini-flash-lite-latest
GEMINI_MONTHLY_TOKEN_BUDGET=1000000
# Pause minimale entre deux appels Gemini (secondes), pour éviter les erreurs 429.
AI_MIN_INTERVAL_SECONDS=4

# -----------------------------------------------------------------------------
# RECOMMANDÉ : Ollama (classification locale des e-mails : pertinence,
# entreprise, secteur, refus/positif). Gemini ne sert qu'à rédiger les e-mails.
# Sans Ollama, la synchro continue mais la classification retombe sur des mots-clés.
# -----------------------------------------------------------------------------
OLLAMA_ENABLED=true
OLLAMA_HOST=http://localhost:11434
OLLAMA_MODEL=llama3.2:1b

# -----------------------------------------------------------------------------
# Gmail : Mots-clés pour filtrer les emails
# Séparés par des virgules, sans espaces.
# Ajoute ici le vocabulaire de TON domaine (ex : data,machine learning,cybersécurité)
# pour que les mails pertinents ne soient pas écartés.
# -----------------------------------------------------------------------------
GMAIL_KEYWORDS=stage,stagiaire,candidature,alternance,apprentissage,internship,recrutement

# -----------------------------------------------------------------------------
# Relances : Jours après l'envoi initial
# -----------------------------------------------------------------------------
FOLLOWUP_DAYS=7,14
FOLLOWUP_MAX_AGE_DAYS=60

# -----------------------------------------------------------------------------
# Synchronisation : Fréquence en minutes
# -----------------------------------------------------------------------------
SYNC_INTERVAL_MINUTES=10

# -----------------------------------------------------------------------------
# Performances : Nombre max de threads à scanner
# -----------------------------------------------------------------------------
SCAN_MAX_THREADS=300

# -----------------------------------------------------------------------------
# Réseau : port et interface d'écoute (utilisés par docker-compose)
# APP_BIND=127.0.0.1 = accessible seulement depuis la machine locale
# -----------------------------------------------------------------------------
APP_PORT=8000
APP_BIND=127.0.0.1

# -----------------------------------------------------------------------------
# Sécurité : Mot de passe pour l'interface (optionnel)
# Laisse vide pour pas de mot de passe
# -----------------------------------------------------------------------------
APP_PASSWORD=

# -----------------------------------------------------------------------------
# OAuth : URI de redirection (optionnel)
# Laisse vide pour utiliser http://localhost:8000/auth/callback
# -----------------------------------------------------------------------------
OAUTH_REDIRECT_URI=

# -----------------------------------------------------------------------------
# Dossiers : Chemins des données
# Par défaut, ne pas changer
# -----------------------------------------------------------------------------
DATA_DIR=./data
SECRETS_DIR=./secrets

# =============================================================================
# Stage Tracker - .gitignore
# =============================================================================

# Environment variables
.env
.env.local
.env.*.local

# Secrets (Gmail credentials)
secrets/*
!secrets/.gitkeep

# Local data (SQLite database, tokens, CV)
data/*
!data/.gitkeep
# Modèles de prompts : seuls les .example sont versionnés. Le profil rempli
# (nom, téléphone, expériences) reste local et ne part jamais sur GitHub.
!data/prompts/
data/prompts/*.md
!data/prompts/*.md.example
!data/prompts/.gitkeep

# Python
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
build/
develop-eggs/
dist/
downloads/
eggs/
.eggs/
lib/
lib64/
parts/
sdist/
var/
wheels/
*.egg-info/
.installed.cfg
*.egg

# Virtual environments
venv/
ENV/
env/
.venv/

# IDE
.idea/
.vscode/
*.swp
*.swo
*~

# OS
.DS_Store
Thumbs.db

# Logs
*.log
logs/

# Local history
.history/

# Docker
.docker/
